#!/usr/bin/env bash
set -euo pipefail

CLI="${KROGER_CLI:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/kroger-pp-cli}"
STAPLES="${KROGER_STAPLES:-$HOME/.config/kroger-pp-cli/staples.tsv}"
MODALITY="${KROGER_MODALITY:-}"
DRY=0
CLEAR=0

usage() {
	cat <<'EOF'
usage: kroger-weekly-cart [--dry-run] [--clear] [--file PATH] [--modality PICKUP|DELIVERY]

  --dry-run   print what would be added and exit without touching the cart

Items Kroger says it can't sell right now are left out and listed.
  --clear     empty the cart first, so the order is exactly the staples list
  --file      staples file (default ~/.config/kroger-pp-cli/staples.tsv)
  --modality  fulfillment type for the added lines (default PICKUP)
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
	--dry-run | -n) DRY=1; shift ;;
	--clear) CLEAR=1; shift ;;
	--file) STAPLES="$2"; shift 2 ;;
	--modality) MODALITY="$2"; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
	esac
done

[ -x "$CLI" ] || { echo "kroger-pp-cli not found at $CLI (build it, or set KROGER_CLI)" >&2; exit 1; }

if [ -z "$MODALITY" ]; then
	MODALITY="$(python3 - "${KROGER_CONFIG:-$HOME/.config/kroger-pp-cli/config.toml}" <<'PY'
import json, re, sys
try:
    text = open(sys.argv[1]).read()
except OSError:
    text = ""
m = re.search(r"""^"?x-modality"?\s*=\s*'(.*)'\s*$""", text, re.M)
try:
    print(json.loads(m.group(1)).get("type") or "PICKUP")
except Exception:
    print("PICKUP")
PY
)"
fi

cli() {
	if [ -n "${KROGER_CONFIG:-}" ]; then "$CLI" --config "$KROGER_CONFIG" "$@"; else "$CLI" "$@"; fi
}
[ -r "$STAPLES" ] || { echo "no staples file at $STAPLES — run kroger-staples first" >&2; exit 1; }

body="$(python3 - "$STAPLES" "$MODALITY" <<'PY'
import json, sys

items, labels = [], []
with open(sys.argv[1]) as fh:
    for lineno, raw in enumerate(fh, 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = raw.rstrip("\n").split("\t")
        if len(parts) < 2:
            sys.exit(f"{sys.argv[1]}:{lineno}: expected tab-separated 'qty<TAB>upc', got: {line}")
        qty, upc = parts[0].strip(), parts[1].strip()
        name = parts[3].strip() if len(parts) > 3 else ""
        if not qty.isdigit() or int(qty) < 1:
            sys.exit(f"{sys.argv[1]}:{lineno}: quantity must be a positive whole number, got {qty!r}")
        items.append({
            "gtin13": upc,
            "substitutionPolicy": "SHOPPER_CHOICE",
            "channel": "WEB",
            "modalityType": sys.argv[2],
            "quantity": int(qty),
            "savedForLater": False,
        })
        labels.append(f"  {qty} x {name or upc}")

if not items:
    sys.exit("every line in the staples file is commented out — uncomment what you want, then re-run")
print("\n".join(labels), file=sys.stderr)
print(json.dumps({"lineItems": items}))
PY
)"

upc_chunks="$(printf '%s' "$body" | python3 -c '
import json, sys
upcs = [i["gtin13"] for i in json.load(sys.stdin)["lineItems"]]
for i in range(0, len(upcs), 24):
    print(",".join(upcs[i:i + 24]))
')"
stock="$(mktemp)"
trap 'rm -f "$stock"' EXIT
checked=1
while IFS= read -r chunk; do
	[ -n "$chunk" ] || continue
	if ! cli products get --gtin13s "$chunk" --json >>"$stock" 2>/dev/null; then
		checked=0
		echo "Couldn't check stock with Kroger; adding everything unchecked." >&2
		break
	fi
done <<<"$upc_chunks"

if [ "$checked" -eq 1 ]; then
	body="$(python3 - "$MODALITY" "$body" "$stock" <<'PY'
import json, sys

modality, body = sys.argv[1], json.loads(sys.argv[2])
with open(sys.argv[3]) as fh:
    stock = fh.read()
docs, dec, pos = [], json.JSONDecoder(), 0
while True:
    while pos < len(stock) and stock[pos].isspace():
        pos += 1
    if pos >= len(stock):
        break
    try:
        doc, pos = dec.raw_decode(stock, pos)
    except ValueError:
        break
    docs.append(doc)
wanted = {i["gtin13"] for i in body["lineItems"]}
unavailable = {}
for doc in docs:
    try:
        products = doc["results"]["data"]["products"]
    except (KeyError, TypeError):
        continue
    for p in products:
        upc = (p.get("item") or {}).get("upc")
        if upc not in wanted:
            continue
        for f in p.get("fulfillmentSummaries") or []:
            a = f.get("availability") or {}
            if f.get("type") == modality and a.get("sellable") is False:
                name = (p.get("item") or {}).get("description") or upc
                unavailable[upc] = (name, a.get("unavailabilityMessage") or "not available")
kept = [i for i in body["lineItems"] if i["gtin13"] not in unavailable]
for upc, (name, why) in unavailable.items():
    print(f"  skipped: {name} ({why})", file=sys.stderr)
if not kept:
    sys.exit("everything on your usual is unavailable right now; nothing to add")
body["lineItems"] = kept
print(json.dumps(body))
PY
)"
fi

if [ "$DRY" -eq 1 ]; then
	echo "" >&2
	echo "--dry-run: nothing was added." >&2
	exit 0
fi

echo "" >&2
echo "Finding your active cart..." >&2
carts="$(mktemp)"
trap 'rm -f "$stock" "$carts"' EXIT
cli cart get --no-cache --json >"$carts"

# Kroger sets quantities: never lower one, and with --clear add before removing.
plan="$(python3 - "$body" "$CLEAR" "$carts" <<'PY'
import json, sys

body, clear = json.loads(sys.argv[1]), sys.argv[2] == "1"
with open(sys.argv[3]) as fh:
    carts = json.load(fh)["results"]["data"]["carts"]
active = next((c for c in carts if c.get("type") == "ACTIVE"), None)
if active is None:
    sys.exit("no ACTIVE cart on this account; open kroger.com and add an item")
lines = active.get("lineItems") or []
have = {}
for li in lines:
    have[li["gtin13"]] = have.get(li["gtin13"], 0) + li["quantity"]
wanted = set()
for item in body["lineItems"]:
    wanted.add(item["gtin13"])
    if not clear:
        item["quantity"] = max(item["quantity"], have.get(item["gtin13"], 0))
removals = [{
    "id": li["id"], "gtin13": li["gtin13"], "quantity": 0,
    "modalityType": li.get("modalityType", "PICKUP"), "channel": "WEB",
    "substitutionPolicy": "SHOPPER_CHOICE", "savedForLater": False,
} for li in lines if clear and li["gtin13"] not in wanted]
print(json.dumps({"cart": active["id"], "add": body, "remove": {"lineItems": removals} if removals else None}))
PY
)"

cart_id="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["cart"])' "$plan")"
python3 -c 'import json,sys; print(json.dumps(json.loads(sys.argv[1])["add"]))' "$plan" |
	cli cart add "$cart_id" --stdin --json >/dev/null
removals="$(python3 -c 'import json,sys; r=json.loads(sys.argv[1])["remove"]; print(json.dumps(r) if r else "")' "$plan")"
if [ -n "$removals" ]; then
	echo "Removing what isn't on your usual..." >&2
	printf '%s' "$removals" | cli cart add "$cart_id" --stdin --json >/dev/null
fi
echo "Done. Review and check out at https://www.kroger.com/cart" >&2
